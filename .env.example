# --- required -----------------------------------------------------------------
# External https origin (no path). The MCP endpoint is PUBLIC_URL/mcp.
PUBLIC_URL=https://trade.example.com
# Encrypts stored platform credentials. openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored API keys cannot be decrypted.
ENCRYPTION_KEY=
# Creates the first admin account on first start (min. 12 characters). Can be removed afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- network ------------------------------------------------------------------
BIND_HOST=127.0.0.1
HOST_PORT=8080
# Number of reverse-proxy hops whose X-Forwarded-For is trusted.
TRUST_PROXY=1
# Browser origins allowed to call /mcp directly (server-to-server calls send no Origin).
ALLOWED_ORIGINS=https://claude.ai,https://www.claude.ai,https://chatgpt.com
# Extra Host header values, if your proxy rewrites Host.
ALLOWED_HOSTS=
# Restrict OAuth client registration to these redirect hosts, e.g. claude.ai,chatgpt.com (empty = any https host).
OAUTH_ALLOWED_REDIRECT_HOSTS=

# --- outbound proxy (static IP for IP-bound API keys) -------------------------
# HTTP(S) proxy for platform API requests, e.g. a tinyproxy on a VPS with a fixed IP.
OUTBOUND_PROXY=
# Platforms routed through it (comma-separated ids, or * for all).
OUTBOUND_PROXY_PLATFORMS=bybit
# Optional: reach OUTBOUND_PROXY through a SOCKS5 server, e.g. a NetBird sidecar in
# userspace mode (NB_USE_NETSTACK_MODE=true) when the host has no /dev/net/tun.
OUTBOUND_PROXY_VIA=

# --- tuning -------------------------------------------------------------------
OAUTH_ACCESS_TOKEN_TTL_MIN=60
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
SNAPSHOT_INTERVAL_MIN=5
PNL_SYNC_INTERVAL_MIN=15
TOOL_LOG_RETENTION_DAYS=365
LOG_LEVEL=info
